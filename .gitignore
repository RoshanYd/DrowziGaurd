# =======================================================
# DrowsiGuard — Comprehensive Sensitive & Build Exclusions
# =======================================================

# Environment & Secret Credentials (Strictly Excluded)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env.*
!.env.local.example
*.pem
*.key
*.cert
*.crt
*.pfx
*.p12
*.id_rsa
*.id_dsa
secrets/
credentials/
tokens.json
token.json
service_account.json
supabase-keys.json

# Node.js / Next.js
node_modules/
.next/
.turbo/
out/
dist/
build/

# Python
__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd
.Python
venv/
env/
.venv/
ENV/
*.egg-info/
.pytest_cache/
.coverage
htmlcov/

# Machine Learning Large Artifacts & Heavy CSVs
ml-pipeline/models/*.pth
ml-pipeline/models/*.onnx
ml-pipeline/data/*.csv

# Operating System Caches
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# IDE & Editor Settings
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.idea/
*.swp
*.swo
*.sublime-workspace

# Build Logs & Debug Artifacts
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
.pnpm-debug.log*

# TypeScript
*.tsbuildinfo
next-env.d.ts
